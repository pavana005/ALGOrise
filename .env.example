# ==============================================================================
# ALGORISE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for local development. Do NOT commit real secrets.
# ==============================================================================

# Backend API Base URL (leave empty for same-origin proxy or local development)
VITE_API_BASE_URL=

# Clerk Authentication Configuration
# Provide your Clerk Publishable Key from https://dashboard.clerk.com
# Vite requires frontend variables to start with VITE_ (e.g. VITE_CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend Clerk Secret Key (Server-only token verification; NEVER expose in client bundles)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Online Compiler / Execution Service (Optional - Built-in runners operate by default)
VITE_COMPILER_API_URL=
VITE_COMPILER_API_KEY=

# Node Environment & Server Configuration
NODE_ENV=production
PORT=5173

# Admin Security (Set a strong password for Algorise admin user 'pav005')
ADMIN_PASSWORD=your_secure_admin_password_here

# Persistent Database File Path (For persistent volume mounts on Railway / Render, e.g. /data/server-db.json)
DB_FILE_PATH=./src/data/server-db.json
